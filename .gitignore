# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.DS_Store

# Secrets / env — never commit real credentials (BR6, INV-02)
.env
.env.local
.env.*.local
# .env.example stays committable (template only, no real values)

# Editor swap / backup files (QA-S-01.3 hygiene)
*.swp
*.swo
.*.sw[a-p]
*~

# Local per-run artifact (ADR-0007 Option E, 2026-09-23) -- carries the
# full CT-02 verdict map (expected/actual/confidence/verdict); the
# platform stays value-free (DEBT-18 option B unchanged). Never commit.
.idp-regression-run-artifacts/

# Golden-set seed data (CLAUDE.md ## Domain: treat golden-set contents as
# sensitive). The golden's authoritative home is its Langfuse dataset
# items, not a copy in git history -- and this repo is publicly readable.
# The files stay on disk where the CLI and scripts expect them
# (scripts/provision_golden_dataset.py reads id_seeds/golden_set.json);
# they are simply never committed. Today's three seeds are synthetic, but
# the rule exists so a golden derived from a real customer document can
# never land here by habit. See id_seeds/README.md.
id_seeds/
