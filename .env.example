# IDP Regression Tester — environment template.
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — NEVER commit secrets (BR6, INV-02, N4/N5/N23).
# `load_dotenv()` runs as the first line of any script, before any SDK client (INV-05).
# Treat golden-set contents and all *_SECRET_* / *_KEY values as sensitive.

# ─── MuleSoft Anypoint IDP (Epic A adapter) ───
# OAuth client credentials — SECRET (env/secrets only; never logged)
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
# Endpoint scoping (config, not secret)
IDP_REGION=
# The application IGNORES this var entirely (ADR-0004 amendment A9,
# 2026-09-22): --org is a REQUIRED CLI flag with no environment fallback,
# same shape as --action/--dataset/--version. An action is addressed by
# (org, action, version) -- the credential is valid for more than one org
# id (IDP access is granted at the business-group level), so the org id
# is NOT derivable from the credential and must be visible in the
# invocation itself. Setting this does NOT configure anything the app
# reads -- it exists only so the live integration tests
# (tests/adapter/test_integration_idp.py,
# tests/orchestration/test_integration_e2e.py) have a target org to
# probe -- test-harness convenience, alongside IDP_ACTION_ID below.
IDP_ORG_ID=
# The application IGNORES this var entirely (tightened 2026-09-22, user
# decision / ADR-0004 amendment A8): --action is a REQUIRED CLI flag
# with no environment fallback, same shape as --version. Setting this
# does NOT configure anything the app reads -- it exists only so the
# live integration tests (tests/adapter/test_integration_idp.py,
# tests/orchestration/test_integration_e2e.py) have a target action to
# probe -- test-harness convenience, alongside IDP_TEST_ACTION_ID below.
IDP_ACTION_ID=
# Configurable terminal-status allowlists (ASM-01); defaults shown
IDP_TERMINAL_STATUSES=SUCCEEDED,FAILED
IDP_SUCCESS_STATUSES=SUCCEEDED
# Two distinct timeouts (Branca / NFR N1): submit-call HTTP + poll wall-clock (seconds)
# Poll timeout pinned by the S-01.6 spike against a live org
IDP_SUBMIT_TIMEOUT_SECONDS=30
IDP_EXECUTION_TIMEOUT_SECONDS=120
# The other adapter timing knobs (DEBT-78). Commented out: the defaults shown
# are what applies when they are unset.
# Seconds between polls. Floor 10. NOTE: the per-poll socket timeout is
# derived from this SAME value (min(interval * 2, remaining budget)), so
# raising it raises that timeout too.
# IDP_POLL_INTERVAL_SECONDS=10
# Refresh the OAuth token this many seconds before it expires.
# IDP_TOKEN_REFRESH_MARGIN_SECONDS=60
# Retries of a transient poll failure (5xx/429), within the execution timeout.
# IDP_POLL_RETRY_MAX_ATTEMPTS=3
# Local document root — document_id resolves to IDP_DOCUMENT_DIR/{document_id} (ADR-0004)
IDP_DOCUMENT_DIR=

# ─── Test-harness-only conveniences (the app ignores all of these) ───
# The application IGNORES all three -- they exist only so
# the opt-in live integration tests (RUN_INTEGRATION_TESTS=1;
# tests/adapter/test_integration_idp.py, tests/orchestration/
# test_integration_e2e.py) have a target action/version/document to
# probe without hand-editing test source. A real CI or local `run_eval`
# invocation must pass --action/--dataset explicitly instead.
IDP_TEST_ACTION_ID=
IDP_TEST_ACTION_VERSION=
IDP_TEST_DOCUMENT_PATH=

# ─── Evaluation platform: Langfuse (self-hosted; ADR-0001, PROVISIONAL on SPIKE-01) ───
# API keys — SECRET. Host = URL of the self-hosted instance.
# Self-hosting obligations (ADR-0001): encryption-at-rest, DB access control, backup (N25).
PLATFORM=langfuse
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# The application IGNORES this var entirely (tightened 2026-09-22, user
# decision / ADR-0004 amendment A8): --dataset is a REQUIRED CLI flag
# with no environment fallback, same shape as --action/--version. Kept
# here only as a test-harness convenience alongside the IDP_TEST_* vars
# above, in case a future live/e2e test wants a default dataset name to
# probe.
GOLDEN_DATASET_NAME=