# Demo environment — copy to the REPO ROOT as `.env`, then fill in.
#
#     cp demopack/env.demo.example .env     # then edit
#
# `.env` is gitignored and must stay that way: it carries the IDP client
# secret and the Langfuse keys. Never paste a filled-in copy into a chat,
# a ticket, or a slide — and do not screen-share this file with real values
# in it. Open it only if you have to, and only before the sponsor joins.
#
# Everything below is read by `scripts/run_eval_local.sh` and the
# integration tests. NOTHING under `src/` reads these (ADR-0004 A8/A9): the
# CLI takes --org/--action/--version/--dataset explicitly, so what a run
# measured is always visible in the invocation itself, never resolved from
# ambient config. The wrapper only composes a command line.

# ---------------------------------------------------------------- MuleSoft
# Anypoint IDP. IDP_ORG_ID is the BUSINESS GROUP id, not the root org id —
# getting this wrong is the usual cause of a 404 on submit.
IDP_ORG_ID=
IDP_ACTION_ID=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
IDP_REGION=us-east-1

# Where the demo PDFs live. Relative to the repo root.
IDP_DOCUMENT_DIR=demopack

# The version the local wrapper runs when you do not pass --version.
# During the demo you will pass --version explicitly instead, so this is
# only a convenience default.
IDP_TEST_ACTION_VERSION=1.0.0

# Poll/timeout budget. The defaults below are the ones the demo was timed
# against (~13 s per single-page document). IDP_POLL_INTERVAL has a 10 s
# floor enforced in code — do not lower it to speed the demo up, it just
# rate-limits you.
IDP_SUBMIT_TIMEOUT_SECONDS=30
IDP_EXECUTION_TIMEOUT_SECONDS=120
IDP_TERMINAL_STATUSES=SUCCEEDED
IDP_SUCCESS_STATUSES=SUCCEEDED

# ---------------------------------------------------------------- Langfuse
# The self-hosted evaluation platform: golden-set storage + run history.
PLATFORM=langfuse
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The demo's golden dataset. Keep this name distinct from any dataset you
# have already run against — a dataset carries its golden items AND the
# committed schema hash, and mixing demo runs into a working dataset makes
# the run history unreadable.
GOLDEN_DATASET_NAME=idp-demo-sponsor

# ------------------------------------------------------------------ Optional
# Verbose output. Leave at INFO for the demo: DEBUG prints a lot and the
# one-line-per-document summary is the thing you want on screen.
IDP_REGRESSION_LOG_LEVEL=INFO
